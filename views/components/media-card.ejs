<article class="media-card"><a href="/m/<%= item.id %>" class="media-artwork"><img src="/api/v1/media/<%= item.id %>/thumbnail" alt="" loading="lazy"><span class="media-type"><%= item.metadata.category %></span></a><div><h2><a href="/media/<%= item.id %>"><%= item.metadata.title %></a></h2><p><%= item.metadata.description||item.metadata.tags.join(' · ')||'Open media details' %></p></div></article>
