<% const previewQuery=item.preview?'?version='+encodeURIComponent(item.version):''; %>
<article class="media-card"><a href="<%= item.preview?'/media/'+item.id+previewQuery:'/m/'+item.id %>" class="media-artwork"><img src="/api/v1/media/<%= item.id %>/thumbnail<%= previewQuery %>" alt="" loading="lazy"><span class="media-type"><%= item.preview?'Private preview':item.metadata.category %></span></a><div><h2><a href="/media/<%= item.id %><%= previewQuery %>"><%= item.metadata.title %></a></h2><p><%= item.metadata.description||item.metadata.tags.join(' · ')||'Open media details' %></p></div></article>
