<label>Title<input name="title" value="<%= data.title||'' %>" maxlength="200" required></label><label>Description<textarea name="description" rows="4" maxlength="10000"><%= data.description||'' %></textarea></label>
<div class="form-grid"><label>Media type<% if(typeof immutableKind!=='undefined'&&immutableKind){ %><input name="kind" value="<%= data.kind %>" readonly><% }else{ %><select name="kind" data-kind><% for(const [kind,label]of [['video','Video'],['audio','Music / audio'],['image','Photo'],['file','Downloadable file']]){ %><option value="<%= kind %>" <%= data.kind===kind?'selected':'' %>><%= label %></option><% } %></select><% } %></label><label>Category<select name="category" data-category><% for(const key of ['movie','series','video','music','photo','file']){ %><option value="<%= key %>" <%= data.category===key?'selected':'' %>><%= key %></option><% } %></select></label><label>Visibility<select name="visibility"><% for(const key of ['private','unlisted','public']){ %><option value="<%= key %>" <%= data.visibility===key?'selected':'' %>><%= key %></option><% } %></select></label><label>Shared link opens<select name="delivery"><option value="viewer" <%= data.delivery==='viewer'?'selected':'' %>>Media web UI</option><% if(policy.allowInline){ %><option value="inline" <%= data.delivery==='inline'?'selected':'' %>>Original file inline</option><% } %><% if(policy.allowDownload){ %><option value="download" <%= data.delivery==='download'?'selected':'' %>>Original download</option><% } %></select></label></div>
<label>Tags<input name="tags" value="<%= (data.tags||[]).join(', ') %>" placeholder="Separate tags with commas"></label><label>Collection<select name="collection"><option value="">No collection</option><% for(const collection of collections){ %><option value="<%= collection.id %>" <%= data.collection===collection.id?'selected':'' %>><%= collection.title %></option><% } %></select></label>
<div class="form-grid"><label>Season<input type="number" name="season" min="0" max="100000" value="<%= data.season||0 %>"></label><label>Episode<input type="number" name="episode" min="0" max="100000" value="<%= data.episode||0 %>"></label></div>
<% if(typeof artwork!=='undefined'&&artwork.length){ %><label>Artwork from your ready images<select name="artwork"><option value="">Use generated artwork</option><% for(const image of artwork){ %><option value="<%= image.id %>" <%= data.artwork===image.id?'selected':'' %>><%= image.title %></option><% } %></select></label><% } %>
