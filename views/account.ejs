<header class="page-heading"><div><p class="eyebrow">Your account</p><h1><%= user.name %></h1><p><%= user.email %></p></div><span class="badge"><%= user.role %></span></header>
<div class="settings-grid"><section class="panel stack"><h2>Creator access</h2><p>Approved creators can upload media. Trusted publishing is granted separately by an administrator.</p><p><strong>Status:</strong> <%= user.creator_status %><% if(user.trusted){ %> · Trusted publisher<% } %></p><% if(user.creator_status!=='approved'&&user.role!=='admin'){ %><form method="post" action="/creator/apply"><%- include('components/csrf') %><button class="button" <%- user.creator_status==='pending'?'disabled':'' %>><%= user.creator_status==='pending'?'Request awaiting review':'Request creator access' %></button></form><% }else{ %><a href="/creator">Open Creator workspace →</a><% } %></section><section class="panel stack"><h2>Change password</h2><p>Changing your password signs out your other sessions.</p><form class="stack" method="post" action="/account/password"><%- include('components/csrf') %><label>Current password<input type="password" name="current" autocomplete="current-password" required></label><label>New password<input type="password" name="password" autocomplete="new-password" minlength="12" maxlength="256" required></label><button class="button">Change password</button></form></section></div>

<section class="panel" data-kn-scroll-settings></section>
