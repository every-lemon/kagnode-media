<header class="page-heading"><div><p class="eyebrow">KagNode Media</p><h1><%= title %></h1><p><%= collection?.description||'Video, music and photos, in one library.' %></p></div><% if(user&&['creator','admin'].includes(user.role)){ %><a class="button primary" href="/creator/upload">＋ Upload media</a><% } %></header>
<form class="filter-bar" action="<%= path==='/search'?'/search':'/browse' %>" method="get"><label>Search<input type="search" name="q" value="<%= query %>" placeholder="Title, description or tag"></label><label>Type<select name="kind"><option value="">All media</option value="video">Video</option><option value="audio">Music &amp; audio</option><option value="image">Photos</option><option value="file">Files</option></select></label><button class="button" type="submit">Find media</button></form>
<% if(items.length){ %><div class="media-grid"><% for(const item of items){ %><%- include('components/media-card',{item}) %><% } %></div><% }else{ %><section class="empty-state"><span class="empty-symbol" aria-hidden="true">◈</span><h2><%= query?'No matching media':'The library is quiet.' %></h2><p><%= query?'Try a different title, type or tag.':'Published movies, music and photos will appear here.' %></p><% if(user?.role==='admin'){ %><a class="button" href="/creator/upload">Upload the first item</a><% }else if(user){ %><a href="/account">Request creator access →</a><% } %></section><% } %>
