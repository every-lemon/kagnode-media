<header class="page-heading"><div><p class="eyebrow">Administration</p><h1>Review &amp; people.</h1><p>Approve creators, review submissions and resolve reports.</p></div><a class="button" href="/admin/settings">Media settings →</a></header>
<section class="panel stack"><h2>Publication review</h2><% for(const submission of reviewRows){ %><article class="review-row"><div><h3><%= submission.metadata.title %></h3><p>From <%= submission.author %></p><a href="/media/<%= submission.media_id %>?version=<%= submission.id %>">Preview exact revision →</a></div><form class="stack" method="post" action="/admin/review/<%= submission.id %>"><%- include('components/csrf') %><label>Review note<input name="note" maxlength="2000"></label><div class="toolbar"><button name="action" value="approve" class="button primary" data-confirm="Approve and publish this exact revision?">Approve</button><button name="action" value="return" class="button">Request changes</button></div></form></article><% } %><% if(!reviewRows.length){ %><p>No submissions waiting.</p><% } %></section>
<section class="panel stack"><h2>Accounts and creator permissions</h2><% for(const person of users){ %><article class="review-row"><div><strong><%= person.name %></strong><p><%= person.email %> · <%= person.role %> · <%= person.creator_status %></p></div><% if(person.role!=='admin'){ %><form class="creator-permissions" method="post" action="/admin/creators/<%= person.id %>"><%- include('components/csrf') %><label class="check"><input type="checkbox" name="approved" <%= person.creator_status==='approved'?'checked':'' %>>Approved creator</label><label class="check"><input type="checkbox" name="trusted" <%= person.trusted?'checked':'' %>>Trusted publishing</label><label>Quota (bytes)<input type="number" name="quota" min="1" value="<%= person.quota %>" required></label><button class="button">Save permissions</button></form><% } %></article><% } %></section>
<section class="panel stack"><h2>Reports</h2><% for(const report of reports){ %><article class="review-row"><div><strong><%= report.title||'Media report' %></strong><p><%= report.reason %></p><small><%= report.state %></small></div><% if(report.state==='open'){ %><form method="post" action="/admin/reports/<%= report.id %>"><%- include('components/csrf') %><div class="toolbar"><button class="button" name="action" value="resolve">Resolve report</button><button class="button" name="action" value="withdraw" data-confirm="Withdraw this media from public delivery and resolve the report?">Withdraw media</button></div></form><% } %></article><% } %><% if(!reports.length){ %><p>No reports.</p><% } %></section>
