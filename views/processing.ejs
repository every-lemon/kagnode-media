<header class="page-heading"><div><p class="eyebrow">Creator workspace</p><h1>Processing queue.</h1><p>Jobs continue in the separate worker. No processing runs in the web request.</p></div><button type="button" class="button" data-refresh-jobs>Refresh</button></header>
<div data-jobs><% for(const job of jobRows){ %><article class="panel job-row"><div><h2><a href="/creator/media/<%= job.media_id %>"><%= job.title %></a></h2><p><%= job.state %> · <%= Math.round(job.progress) %>%</p><% if(job.error){ %><p class="error"><%= job.error %></p><% } %></div><progress max="100" value="<%= job.progress %>" aria-label="Processing progress"></progress><% if(['queued','processing'].includes(job.state)){ %><button class="button" type="button" data-job-action="cancel" data-job="<%= job.id %>"><%- icon('close') %> Cancel</button><% }else if(['failed','cancelled'].includes(job.state)){ %><button class="button" type="button" data-job-action="retry" data-job="<%= job.id %>"><%- icon('refresh') %> Retry</button><% } %></article><% } %><% if(!jobRows.length){ %><section class="empty-state"><h2>No jobs in the queue.</h2></section><% } %></div><p data-jobs-feedback role="status"></p>
