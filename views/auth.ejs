<section data-core-login data-core-login-product="KagNode Media"><div class="auth-card kn-core-login-card"><div class="kn-core-login-heading"><a class="brand" href="/"><img src="<%= asset('favicon.svg') %>" width="32" height="32" alt=""><strong>KagNode. Media</strong></a><h1><%= mode==='signup'?'Create an account':'Sign in' %></h1><p>Your account belongs to this Media installation.</p></div><div class="kn-core-login-content"><form class="stack" method="post" action="/<%= mode %>"><%- include('components/csrf') %><% if(mode==='signup'){ %><label>Your name<input name="name" maxlength="100" autocomplete="name" required></label><% } %><label>Email<input type="email" name="email" maxlength="254" autocomplete="username" required></label><label>Password<input type="password" name="password" minlength="12" maxlength="256" autocomplete="<%= mode==='signup'?'new-password':'current-password' %>" required></label><button type="submit" class="button primary"><%= mode==='signup'?'Create account':'Sign in' %></button></form><% if(mode==='signup'){ %><a href="/login">Already have an account? Sign in</a><% }else if(policy.registration){ %><a href="/signup">Create a viewer account</a><% } %></div><% if(providerEnabled){ %><div class="kn-core-login-provider"><button type="button" data-core-login-provider disabled>Login with KagNode</button><p><%= policy.registration?'New connections create a viewer account. Creator access requires local approval.':'Registration is closed. Connect an existing account from its settings first.' %></p><div data-core-login-status role="status"></div></div><% } %></div></section>
