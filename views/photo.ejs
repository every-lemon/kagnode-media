<header class="page-heading"><div><a href="/media/<%= entry.id %>">← Photo details</a><h1><%= entry.metadata.title %></h1></div><div class="toolbar"><button class="button" type="button" data-photo-zoom="out">− Zoom</button><button class="button" type="button" data-photo-zoom="reset">Fit</button><button class="button" type="button" data-photo-zoom="in">＋ Zoom</button></div></header><div class="photo-viewer" data-photo-viewer><img src="/api/v1/media/<%= entry.id %>/streams/photo.webp?version=<%= entry.version %>" alt="<%= entry.metadata.description||entry.metadata.title %>" data-photo></div><p class="description"><%= entry.metadata.description %></p><% if(entry.metadata.collection){ %><a href="/albums/<%= entry.metadata.collection %>">Back to album →</a><% } %>
