<!doctype html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><meta name="color-scheme" content="dark light">
  <title><%= title %> · KagNode Media</title><link rel="icon" href="<%= asset('favicon.svg') %>">
  <link rel="stylesheet" href="<%= asset('kagnode-ui.css') %>"><script src="<%= asset('theme.js') %>"></script><link rel="stylesheet" href="<%= asset('inputs.css') %>"><script src="<%= asset('inputs.js') %>" defer></script><link rel="stylesheet" href="<%= asset('media.css') %>"><link rel="stylesheet" href="<%= asset('kagnode-scroll.css') %>">
  <script src="<%= asset('media.js') %>" defer></script><script src="<%= asset('kagnode-scroll.js') %>" defer></script>
  <% if(page==='player'){ %><script src="<%= asset('hls.js') %>" defer></script><script src="<%= asset('player.js') %>" defer></script><% } %>
<meta name="csrf-token" content="<%= csrf %>"><link rel="stylesheet" href="<%= asset('kagnode-account.css') %>"><script src="<%= asset('kagnode-account.js') %>" defer></script></head>
<body data-kn-account-app="media" data-kn-manual-navigation class="kn-ui">
<a class="skip-link" href="#main">Skip to content</a><div class="page-progress" hidden data-page-progress></div>
<button type="button" class="sidebar-scrim" data-close-navigation aria-label="Close navigation" hidden></button>
<aside class="sidebar"><a class="brand" href="/"><svg viewBox="0 0 32 32" aria-hidden="true"><path d="M4 18C4 9 11 4 23 5L18 27C10 28 4 25 4 18Z"/><path d="m25 11 4 5-3 10-4-3Z"/></svg><span><strong>KagNode<span>.</span></strong><small>Media</small></span></a>
<a class="website-link" href="https://nebulacoder.com" target="_blank" rel="noreferrer">KagNode Website <span aria-hidden="true">↗</span></a><p class="nav-label">Library</p>
<nav aria-label="Media navigation"><% for(const [href,label,symbol]of [['/','Discover','home'],['/movies','Movies','play'],['/series','Series','panel'],['/music','Music','waveform'],['/photos','Photos','images'],['/favorites','Favorites','star']]){ %><a href="<%= href %>" <%- path===href?'aria-current="page"':'' %>><%- icon(symbol) %><%= label %></a><% } %></nav>
<% if(user&&['creator','admin'].includes(user.role)){ %><p class="nav-label">Create</p><nav aria-label="Creator navigation"><% for(const [href,label]of [['/creator','Your media'],['/creator/upload','Upload'],['/creator/collections','Collections'],['/creator/processing','Processing']]){ %><a href="<%= href %>" <%- path===href?'aria-current="page"':'' %>><%= label %></a><% } %></nav><% } %>
<% if(user?.role==='admin'){ %><p class="nav-label">Manage</p><nav aria-label="Administration"><a href="/admin">Review &amp; people</a><a href="/admin/library">Local libraries</a><a href="/admin/settings">Settings</a></nav><% } %><div class="sidebar-bottom">KagNode Media · 0.1 preview</div></aside>
<div class="workspace"><header class="topbar"><button class="icon-button" type="button" data-mobile aria-label="Open navigation" aria-expanded="false"><%- icon('menu') %></button><form action="/search" method="get" class="header-search" role="search"><label class="sr-only" for="search">Search the media library</label><span aria-hidden="true">⌕</span><input id="search" name="q" type="search" placeholder="Search your library" value="<%= typeof query==='string'?query:'' %>"></form><div class="account-controls"><% if(user){ %><details class="account-menu"><summary><span class="avatar" data-kn-account-avatar><%= user.name.slice(0,1).toUpperCase() %></span><span data-kn-account-name><%= user.name %></span><span aria-hidden="true">⌄</span></summary><div><p class="muted"><%= user.email %></p><a href="/account">Account &amp; access</a><form method="post" action="/logout"><%- include('components/csrf') %><button type="submit">Sign out</button></form></div></details><% }else{ %><a class="button" href="/login">Sign in</a><% } %></div></header>
<main id="main" tabindex="-1"><% if(typeof error!=='undefined'&&error){ %><div class="notice error" role="alert"><%= error %></div><% } %><% if(typeof notice!=='undefined'&&notice){ %><div class="notice" role="status"><%= notice %></div><% } %><%- include(page) %></main>
<footer class="kn-product-signature"><span><strong>KagNode<span>.</span></strong> Media</span><a href="https://github.com/every-lemon/kagnode-media" target="_blank" rel="noreferrer">Source · AGPL-3.0-only ↗</a></footer></div>
<dialog class="confirm-dialog" data-confirm-dialog aria-labelledby="confirm-title"><h2 id="confirm-title">Confirm this action</h2><p data-confirm-message></p><div class="toolbar"><button class="button" type="button" data-confirm-cancel>Cancel</button><button class="button primary" type="button" data-confirm-accept>Confirm</button></div></dialog>
<div class="loading-screen" data-loading-screen hidden aria-live="polite"><svg viewBox="0 0 32 32" aria-hidden="true"><path d="M4 18C4 9 11 4 23 5L18 27C10 28 4 25 4 18Z"/><path d="m25 11 4 5-3 10-4-3Z"/></svg><span class="loading-dots" aria-hidden="true"><i></i><i></i><i></i></span><p data-loading-label>Loading…</p></div>
</body></html>
