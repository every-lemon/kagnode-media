<header class="page-heading"><div><p class="eyebrow">Creator workspace</p><h1>Your media.</h1><p>Work on drafts and review the exact revision before publishing.</p></div><a class="button primary" href="/creator/upload"><%- icon('upload') %> Upload media</a></header>
<% if(uploads.length){ %><section class="panel"><h2>Unfinished uploads</h2><% for(const upload of uploads){ %><p><strong><%= upload.filename %></strong> · <%= Math.round(upload.offset/upload.size*100) %>% · <a href="/creator/upload">Select the same file to resume →</a></p><% } %></section><% } %>
<% if(!items.length){ %><section class="empty-state"><h2>No media yet.</h2><p>Start with a file or import from an administrator-configured local library.</p></section><% } %>
<div class="creator-list"><% for(const item of items){ %><article class="panel creator-row"><div><h2><a href="/creator/media/<%= item.id %>"><%= item.metadata.title %></a></h2><p><%= item.state %> · <%= item.publication %> <%= item.removed?'· Removed':'' %></p></div><div class="toolbar"><a class="button" href="/creator/media/<%= item.id %>">Edit draft</a><% if(item.published&&!item.removed){ %><a class="button" href="/media/<%= item.id %>">Published view</a><% } %><% if(item.removed){ %><form method="post" action="/creator/media/<%= item.id %>/restore"><%- include('components/csrf') %><input type="hidden" name="confirm" value="yes"><button class="button"><%- icon('refresh') %> Restore draft</button></form><% } %></div></article><% } %></div>
