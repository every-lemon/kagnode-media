<header class="page-heading"><div><p class="eyebrow">Administration</p><h1>Import local media.</h1><p>Only roots configured by the server administrator can be scanned.</p></div></header>
<% if(!roots.length){ %><section class="panel"><p>No library roots are configured. Set LIBRARY_ROOTS in the server configuration, then restart the web service.</p></section><% }else{ %><form class="filter-bar" method="get"><label>Library root<select name="root"><% roots.forEach((root,index)=>{ %><option value="<%= index %>" <%= selectedRoot===index?'selected':'' %>><%= root %></option><% }); %></select></label><button class="button">Scan root</button></form><form class="panel stack" method="post" action="/admin/library"><%- include('components/csrf') %><input type="hidden" name="root" value="<%= selectedRoot %>"><label>File<select name="file" required><% for(const file of files){ %><option value="<%= file %>"><%= file %></option><% } %></select></label><%- include('components/metadata-fields',{data:{kind:'video',category:'video',visibility:'private',delivery:'viewer',tags:[]},immutableKind:false}) %><button class="button primary" <%- !files.length?'disabled':'' %>>Import a private draft</button></form><% } %>
