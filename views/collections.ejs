<header class="page-heading"><div><p class="eyebrow">Creator workspace</p><h1>Your collections.</h1><p>Group episodes, tracks and photos without moving source files.</p></div></header><div class="settings-grid"><section class="panel stack"><h2>Collections</h2><% for(const collection of collections){ %><a href="/collections/<%= collection.id %>"><strong><%= collection.title %></strong> · <%= collection.kind %></a><% } %><% if(!collections.length){ %><p>No collections yet.</p><% } %></section><form class="panel stack" method="post" action="/creator/collections"><%- include('components/csrf') %><h2>New collection</h2><label>Title<input name="title" maxlength="200" required></label><label>Type<select name="kind"><option value="series">Series</option><option value="audio">Audio album</option><option value="photos">Photo album</option></select></label><label>Description<textarea name="description" maxlength="5000"></textarea></label><button class="button primary"><%- icon('plus') %> Create collection</button></form></div>
