<header class="page-heading"><div><p class="eyebrow"><%= entry.metadata.category %></p><h1><%= entry.metadata.title %></h1><p><%= entry.metadata.tags.join(' · ') %></p></div></header>
<div class="media-detail"><div class="detail-cover"><img src="/api/v1/media/<%= entry.id %>/thumbnail?version=<%= entry.version %>" alt=""></div><section class="panel stack"><h2>About this item</h2><p class="description"><%= entry.metadata.description||'No description has been added.' %></p><div class="toolbar"><% if(entry.metadata.kind!=='file'){ %><a class="button primary" href="/<%= entry.metadata.kind==='video'?'watch':entry.metadata.kind==='audio'?'listen':'photos' %>/<%= entry.id %>?version=<%= entry.version %>"><%= entry.metadata.kind==='image'?'View photo':'Play media' %> →</a><% } %><% if(policy.allowInline){ %><a class="button" href="/api/v1/media/<%= entry.id %>/raw?version=<%= entry.version %>">Original file</a><% } %><% if(policy.allowDownload){ %><a class="button" href="/api/v1/media/<%= entry.id %>/raw?download=1&amp;version=<%= entry.version %>">Download</a><% } %></div><% if(entry.metadata.collection){ %><a href="/collections/<%= entry.metadata.collection %>">Open collection →</a><% } %><p class="small muted">Shared link: <a href="/m/<%= entry.id %>">/m/<%= entry.id %></a></p>
<% if(user){ %><button class="button" type="button" data-favorite="<%= entry.id %>" aria-pressed="<%= favorite %>"><%= favorite?'Remove favorite':'Add to favorites' %></button><details><summary>Report a problem</summary><form data-report="<%= entry.id %>" class="stack"><%- include('components/csrf') %><label>What is wrong?<textarea name="reason" maxlength="2000" required></textarea></label><button class="button">Send report</button><p role="status" data-report-status></p></form></details><% } %></section></div>
