<header class="page-heading"><div><a href="/media/<%= entry.id %>">← Media details</a><h1><%= entry.metadata.title %></h1></div></header>
<section class="player" data-player data-id="<%= entry.id %>" data-version="<%= entry.version %>" data-kind="<%= entry.metadata.kind %>" data-progress="<%= progress %>" data-signed-in="<%= !!user %>" data-profiles="<%= JSON.stringify(entry.processing.profiles||[]) %>">
<% if(entry.metadata.kind==='audio'){ %><div class="audio-art"><img src="/api/v1/media/<%= entry.id %>/thumbnail?version=<%= entry.version %>" alt=""><h2><%= entry.metadata.title %></h2></div><audio controls preload="metadata" data-media-element></audio><% }else{ %><video controls playsinline preload="metadata" poster="/api/v1/media/<%= entry.id %>/thumbnail?version=<%= entry.version %>" data-media-element></video><% } %>
<div class="player-controls" data-player-controls hidden data-native-scroll><div class="seek-row"><span data-player-time>0:00</span><label class="sr-only" for="seek">Playback position</label><input id="seek" type="range" min="0" max="1000" value="0" step="1" data-player-seek><span data-player-duration>0:00</span></div><div class="toolbar"><button class="button" type="button" data-player-play aria-label="Play"><%- icon('play') %> Play</button><button class="button" type="button" data-player-skip="-10"><%- icon('rewind') %> −10s</button><button class="button" type="button" data-player-skip="10"><%- icon('fast-forward') %> +10s</button><label class="volume">Volume<input type="range" min="0" max="1" step="0.05" value="1" data-player-volume></label><label>Quality<select data-player-quality><option value="auto">Auto</option></select></label><button class="button" type="button" data-player-fullscreen><%- icon('fullscreen') %> Fullscreen</button></div></div><p class="player-status" data-player-status role="status">Loading media…</p>
</section><p class="description"><%= entry.metadata.description %></p>
