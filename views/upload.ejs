<header class="page-heading"><div><p class="eyebrow">Creator workspace</p><h1>Upload media.</h1><p>Add a file, set its details, then send it to the processing queue.</p></div></header>
<form class="panel upload-wizard" data-upload-wizard data-user="<%= user.id %>"><%- include('components/csrf') %><nav class="wizard-steps" aria-label="Upload steps"><span data-step-label="0" aria-current="step">1 File</span><span data-step-label="1">2 Details</span><span data-step-label="2">3 Upload</span></nav>
<section data-step="0"><h2>Choose a file</h2><label class="file-drop"><span aria-hidden="true">＋</span><strong>Select a video, audio file or photo</strong><input type="file" data-upload-file required><small data-file-summary>Uploads can resume after a connection interruption.</small></label></section>
<section data-step="1" hidden><h2>Media details</h2><div class="stack"><%- include('components/metadata-fields',{data:{kind:'video',category:'video',visibility:'private',delivery:'viewer',tags:[]},immutableKind:false}) %></div></section>
<section data-step="2" hidden><h2>Upload and process</h2><p>Your file stays private until processing is ready and publication is approved or allowed by your creator permissions.</p><progress max="100" value="0" data-upload-progress aria-label="Upload progress"></progress><p data-upload-status role="status">Ready to upload.</p><a data-upload-result class="button primary" hidden>Open media draft →</a></section>
<div class="toolbar wizard-actions"><button type="button" class="button" data-step-back hidden>Back</button><button type="button" class="button primary" data-step-next>Continue</button><button type="button" class="button primary" data-upload-start hidden>Start / resume upload</button><button type="button" class="button" data-upload-cancel hidden>Cancel upload</button></div><p class="error" data-upload-error role="alert" hidden></p><noscript>Enable JavaScript for resumable uploads, or use the documented upload API.</noscript></form>
