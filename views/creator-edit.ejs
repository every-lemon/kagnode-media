<header class="page-heading"><div><p class="eyebrow">Creator workspace</p><h1><%= entry.metadata.title %></h1><p><%= entry.state %> · <%= entry.publication %></p></div><a class="button" href="/creator/processing">Processing queue →</a></header>
<div class="settings-grid"><form class="panel stack" method="post" action="/creator/media/<%= entry.id %>/save"><%- include('components/csrf') %><input type="hidden" name="version" value="<%= entry.version %>"><%- include('components/metadata-fields',{data:entry.metadata,immutableKind:true}) %><button class="button primary">Save metadata draft</button></form><aside class="stack"><section class="panel stack"><h2>Publication</h2><p><%= user.role==='admin'||user.trusted?'You can publish ready media directly.':'Submit ready media for administrator review.' %></p><% if(entry.state==='ready'){ %><a href="/media/<%= entry.id %>?version=<%= entry.version %>" class="button">Preview this revision</a><form method="post" action="/creator/media/<%= entry.id %>/publish"><%- include('components/csrf') %><input type="hidden" name="version" value="<%= entry.version %>"><button class="button primary" data-confirm="Publish or submit this exact saved revision?" <%- entry.removed?'disabled':'' %>><%= user.role==='admin'||user.trusted?'Publish saved revision':'Submit for review' %></button></form><% }else{ %><p class="small muted">Processing must finish before this revision can be published.</p><% } %></section><section class="panel stack"><h2>Revision history</h2><% for(const review of reviews){ %><article><strong><%= review.outcome %></strong><p><%= review.note %></p><small><%= new Date(review.created).toLocaleString() %></small></article><% } %><% if(!reviews.length){ %><p>No publication decisions yet.</p><% } %></section><section class="panel stack"><h2>Remove from view</h2><% for(const action of ['withdraw','remove']){ %><form method="post" action="/creator/media/<%= entry.id %>/<%= action %>"><%- include('components/csrf') %><input type="hidden" name="confirm" value="yes"><button class="text-button danger" data-confirm="Remove this media from public delivery? Source files and revision history are retained."><%= action==='withdraw'?'Withdraw publication':'Remove media' %></button></form><% } %></section></aside></div>
