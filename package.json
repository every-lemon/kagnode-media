{
  "name": "kagnode-media",
  "version": "5.0.1",
  "private": true,
  "description": "KagNode Media: self-hosted publishing, playback and photo libraries",
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc && node scripts/build-web.mjs",
    "start": "node dist/server.js",
    "worker": "node dist/worker.js",
    "cli": "node dist/cli.js",
    "test": "tsx --test --test-concurrency=2 tests/*.test.ts",
    "check": "tsc --noEmit",
    "format": "prettier --write 'src/**/*.ts' 'tests/**/*.ts' 'public/*.css' 'public/*.js'",
    "format:check": "prettier --check 'src/**/*.ts' 'tests/**/*.ts'"
  },
  "dependencies": {
    "ejs": "3.1.10",
    "express": "5.1.0",
    "express-rate-limit": "8.7.3",
    "helmet": "8.1.0",
    "hls.js": "1.7.4",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@types/ejs": "3.1.5",
    "@types/express": "5.0.3",
    "@types/node": "24.10.0",
    "@types/supertest": "6.0.3",
    "esbuild": "0.28.2",
    "prettier": "3.7.4",
    "supertest": "7.3.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
